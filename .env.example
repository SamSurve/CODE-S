# ==============================================================
# AOA Practical Codes — Environment Configuration
# ==============================================================

# Judge0 Execution API Endpoint
# Default is the public Judge0 Community Edition API:
JUDGE0_API_URL=https://ce.judge0.com

# If using Judge0 via RapidAPI, set your API key and host:
# JUDGE0_API_KEY=your_rapidapi_key_here
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# If using a self-hosted Judge0 instance requiring an auth token:
# JUDGE0_AUTH_TOKEN=your_auth_token_here
